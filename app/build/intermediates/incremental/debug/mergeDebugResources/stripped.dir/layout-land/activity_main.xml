<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0F172A"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.45"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnGameMenu"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/back_to_games"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/tvAppVersion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPrivatePlayerCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/private_player_card_count_initial"
            android:textColor="#60A5FA"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSeriesScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/series_score_initial"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/playerCounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1E293B"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvPlayerCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="אתה: 26"
                android:textColor="#60A5FA"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCpuCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="מחשב: 26"
                android:textColor="#F87171"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:minHeight="32dp"
            android:text="לחץ על שלוף קלף"
            android:textColor="#F1F5F9"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/cardArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:gravity="center"
            android:orientation="horizontal">

            <com.gamebox.common.ui.PlayingCardView
                android:id="@+id/cardPlayer"
                android:layout_width="90dp"
                android:layout_height="126dp"
                android:contentDescription="קלף השחקן"
                android:layout_marginEnd="24dp" />

            <com.gamebox.common.ui.PlayingCardView
                android:id="@+id/cardCpu"
                android:layout_width="90dp"
                android:layout_height="126dp"
                android:contentDescription="קלף המחשב" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="10dp">

        <TextView
            android:id="@+id/tvPublicMessageStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/public_message_needs_display"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <AutoCompleteTextView
            android:id="@+id/inputPublicMessage"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:contentDescription="@string/public_message_picker_description"
            android:hint="@string/public_message_hint"
            android:inputType="textCapSentences|text"
            android:maxLength="80"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textColorHint="#94A3B8" />

        <Button
            android:id="@+id/btnSendPublicMessage"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:enabled="false"
            android:text="@string/send_to_public_screen"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnDraw"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#3B82F6"
            android:text="שלוף קלף"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnNewGame"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/next_war_game"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnResetSeries"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/reset_series_score"
            android:textAllCaps="false"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDisplayStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/external_display_disconnected"
            android:textColor="#94A3B8"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
