<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/game_war"
        android:textColor="@color/text"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/war_setup_description"
        android:textColor="#CBD5E1"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/catalog_game_background"
        android:padding="16dp"
        android:text="@string/war_selected_mode"
        android:textColor="@color/text"
        android:textSize="17sp" />

    <Button
        android:id="@+id/btnStartWar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="@string/start_game"
        android:textAllCaps="false"
        android:textSize="18sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/war_multiplayer_heading"
        android:textColor="@color/text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnHostWar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="@string/war_host_game"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/btnJoinWar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="@string/war_join_game"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/btnSetupBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/back_to_games"
        android:textAllCaps="false" />

</LinearLayout>
