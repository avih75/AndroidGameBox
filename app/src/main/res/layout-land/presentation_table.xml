<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="#0C4A6E"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="מלחמה"
            android:textColor="#F1F5F9"
            android:textSize="34sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp">

            <TextView
                android:id="@+id/tvPlayerCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="32dp"
                android:text="אתה: 26"
                android:textColor="#93C5FD"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCpuCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="מחשב: 26"
                android:textColor="#FCA5A5"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSeriesScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="10dp"
            android:text="@string/series_score_initial"
            android:textColor="#FDE68A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAppVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <com.gamebox.common.ui.PlayingCardView
        android:id="@+id/cardPlayer"
        android:layout_width="150dp"
        android:layout_height="210dp"
        android:layout_marginEnd="28dp"
        android:contentDescription="קלף השחקן"
        android:elevation="16dp" />

    <com.gamebox.common.ui.PlayingCardView
        android:id="@+id/cardCpu"
        android:layout_width="150dp"
        android:layout_height="210dp"
        android:layout_marginEnd="28dp"
        android:contentDescription="קלף המחשב"
        android:elevation="16dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#F1F5F9"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPublicMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="40dp"
            android:paddingTop="8dp"
            android:textColor="#FDE68A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
